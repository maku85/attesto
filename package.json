{
  "name": "attesto",
  "version": "0.0.0",
  "description": "A career knowledge base exposed via MCP, with claim-level provenance. No source, no claim.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "attesto": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "migrations",
    "templates"
  ],
  "scripts": {
    "attesto": "node --disable-warning=ExperimentalWarning src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
